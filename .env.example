# Copiez ce fichier en « .env.local » puis renseignez vos valeurs (voir README, section OneDrive).
# Sans VITE_MSAL_CLIENT_ID, les boutons OneDrive n'apparaissent pas.

# ID d'application (client) de l'inscription Microsoft Entra ID
VITE_MSAL_CLIENT_ID=

# Facultatif : limiter la connexion au locataire de votre établissement
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<ID-du-locataire>

# Facultatif : héberger Pyodide vous-même
# VITE_PYODIDE_URL=./pyodide/
